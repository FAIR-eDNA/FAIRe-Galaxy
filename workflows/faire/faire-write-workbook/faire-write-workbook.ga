{
    "name": "FAIRe mapper: write and check a FAIRe workbook",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "The second step from a lab's own tables to FAIRe. Writes a FAIRe workbook, in the layout\nFAIRe-ator makes, from the sample table and its reviewed crosswalk (from \"FAIRe mapper: propose\na mapping\"), values for the whole project and an OTU or ASV table, then checks it with\nFAIRe-fier. For library tables, a raw and a final OTU table, or several assays, run the apply\nmapping tool on its own.\n",
    "tags": [],
    "license": "MIT",
    "release": "0.1",
    "uuid": "4b93d86b-5451-4866-9404-ff48d36b064c",
    "creator": [
        {
            "name": "FAIRe Galaxy project contributors",
            "class": "Organization"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "sample_table",
            "type": "data_input",
            "label": "sample_table",
            "annotation": "The same sample table given to \"propose a mapping\".",
            "tool_state": "{\"name\": \"sample_table\", \"format\": [\"csv\", \"tabular\", \"xlsx\", \"txt\"]}",
            "position": {
                "top": 0,
                "left": 0
            },
            "input_connections": {},
