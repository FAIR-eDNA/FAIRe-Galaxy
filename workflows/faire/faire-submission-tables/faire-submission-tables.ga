{
    "name": "FAIRe: check a workbook and make submission tables",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "From a filled-in FAIRe workbook (a FAIRe-ator template, or the output of \"FAIRe mapper: write\nand check a FAIRe workbook\"): checks it with FAIRe-fier, and makes the NCBI BioSample and SRA\ntables, the ENA sample XML and the QIIME 2 metadata and manifests. The ENA experiment and run\nXML need the sample receipt ENA returns, so run \"FAIRe2ENA: experiments and runs\" afterwards.\nNothing is submitted.\n",
    "tags": [],
    "license": "MIT",
    "release": "0.1",
    "uuid": "1de36135-9f50-4a40-ae1f-ee27e3e9e302",
    "creator": [
        {
            "name": "FAIRe Galaxy project contributors",
            "class": "Organization"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "workbook",
            "type": "data_input",
            "label": "workbook",
            "annotation": "A FAIRe workbook.",
            "tool_state": "{\"name\": \"workbook\", \"format\": [\"xlsx\"]}",
            "position": {
                "top": 0,
                "left": 0
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "workbook",
                    "description": ""
                }
