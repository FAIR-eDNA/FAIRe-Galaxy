            "type": "parameter_input",
            "label": "center_name",
            "annotation": "Your institution as registered with your ENA Webin account, for example CSIRO.",
            "tool_state": "{\"name\": \"center_name\", \"parameter_type\": \"text\"}",
            "position": {
                "top": 10,
                "left": 10
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "center_name",
                    "description": ""
