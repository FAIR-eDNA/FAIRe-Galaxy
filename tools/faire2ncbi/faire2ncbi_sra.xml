            <option value="blank_only">Yes, only runs with an empty associatedSequences cell</option>
        </param>
        <param name="instrument_model" type="select" label="Sequencing instrument"
            help="NCBI's controlled values (from the SRA metadata template). 'From the workbook' uses the platform and instrument rows of projectMetadata for each assay, after removing ontology codes such as [OBI_0002003]; the tool stops if they are missing or not NCBI values. Choosing an instrument sets it, and its platform, for every run.">
            <option value="from_workbook" selected="true">From the workbook</option>
            <option value="HiSeq X Five">HiSeq X Five (ILLUMINA)</option>
            <option value="HiSeq X Ten">HiSeq X Ten (ILLUMINA)</option>
            <option value="Illumina Genome Analyzer">Illumina Genome Analyzer (ILLUMINA)</option>
            <option value="Illumina Genome Analyzer II">Illumina Genome Analyzer II (ILLUMINA)</option>
            <option value="Illumina Genome Analyzer IIx">Illumina Genome Analyzer IIx (ILLUMINA)</option>
            <option value="Illumina HiScanSQ">Illumina HiScanSQ (ILLUMINA)</option>
            <option value="Illumina HiSeq 1000">Illumina HiSeq 1000 (ILLUMINA)</option>
