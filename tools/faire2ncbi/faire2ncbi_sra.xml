        <expand macro="faire_input"/>
        <conditional name="runs">
            <param name="runs_by" type="select" label="Runs to include"
                help="Each row of experimentRunMetadata is one amplicon of a sample (FAIRe's library). NCBI needs a unique library_ID on every row of a submission. A library that holds several assays (the same sample and files on each row) gets one row.">
                <option value="all" selected="true">All runs</option>
                <option value="assay">Runs of some assays (assay_name)</option>
                <option value="seq_run">Runs from some sequencing runs (seq_run_id)</option>
                <option value="lib_id">Some libraries (lib_id)</option>
            </param>
            <when value="all"/>
            <when value="assay">
                <expand macro="runs_values" field="assay_name" example="MiFish-U,COI-Leray"/>
            </when>
            <when value="seq_run">
                <expand macro="runs_values" field="seq_run_id" example="RUN01,RUN02"/>
