<tool id="faire2ncbi_sra" name="FAIRe2NCBI: SRA" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>make an NCBI SRA metadata table from a FAIRe workbook</description>
    <macros>
        <import>macros.xml</import>
        <import>faire_guide.xml</import>
    </macros>
    <expand macro="creator"/>
    <expand macro="requirements"/>
    <version_command>echo '@TOOL_VERSION@'</version_command>
    <command detect_errors="exit_code"><![CDATA[
set -o pipefail;
@LINK_INPUT@
python '$__tool_directory__/faire2ncbi_galaxy.py' sra
    --input_file input.xlsx
    --runs_by '$runs.runs_by'
    #if $runs.runs_by != 'all':
        --runs_values '$runs.runs_values'
    #end if
    --associated '$associated'
    #if $instrument_model != 'from_workbook':
        --instrument_model '$instrument_model'
    #end if
    #if $link.link_by == 'accessions':
        --accessions '$link.accessions'
    #end if
    @ORGANISM@
    --output '$sra_table'
    --config_out '$config'
    < /dev/null
| tee '$log'
    ]]></command>
